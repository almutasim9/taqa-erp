# Public Supabase browser configuration — safe to expose to the client.
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key

# Server-only Supabase administrative key. Never prefix this key with NEXT_PUBLIC.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Used by server actions to generate application URLs and receipts.
NEXT_PUBLIC_APP_URL=http://localhost:3000
